{
  "_doc": "Composable index template for the deception-alerts data stream (alerts derived from the normalized events, generated by the Dystopia processor). Retention higher, event.severity is required as long. Compatible with ECS 8.x. It shares the event contract with deception-events but adds dystopia.alert.* fields.",
  "index_patterns": [
    "deception-alerts",
    "deception-alerts-*"
  ],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "lifecycle": {
          "name": "deception-alerts-policy",
          "rollover_alias": "deception-alerts"
        },
        "refresh_interval": "5s",
        "codec": "best_compression"
      }
    },
    "mappings": {
      "dynamic": "false",
      "_meta": {
        "dystopia": "1.0.0",
        "ecs_version": "8.x",
        "hp_oce": "agent4-elastic"
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "event": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 512
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 256
            },
            "category": {
              "type": "keyword",
              "ignore_above": 256
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "action": {
              "type": "keyword",
              "ignore_above": 256
            },
            "severity": {
              "type": "long"
            },
            "outcome": {
              "type": "keyword",
              "ignore_above": 256
            },
            "dataset": {
              "type": "keyword",
              "ignore_above": 256
            },
            "reason": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "source": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "geo": {
              "type": "object",
              "dynamic": "false",
              "properties": {
                "country_name": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 8
                },
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        },
        "destination": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            }
          }
        },
        "network": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "transport": {
              "type": "keyword",
              "ignore_above": 64
            },
            "protocol": {
              "type": "keyword",
              "ignore_above": 128
            }
          }
        },
        "observer": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "name": {
              "type": "keyword",
              "ignore_above": 128
            },
            "product": {
              "type": "keyword",
              "ignore_above": 128
            }
          }
        },
        "session": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "dystopia": {
          "type": "object",
          "dynamic": "strict",
          "properties": {
            "schema_version": {
              "type": "keyword",
              "ignore_above": 16
            },
            "device_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "segment_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "instance_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "persona": {
              "type": "keyword",
              "ignore_above": 128
            },
            "decoy_credentials": {
              "type": "keyword",
              "ignore_above": 256,
              "_comment": "Identifiers of the decoy credentials involved, NEVER the value."
            },
            "raw_reference": {
              "type": "keyword",
              "ignore_above": 512
            },
            "ingest_source": {
              "type": "keyword",
              "ignore_above": 64
            },
            "control_version": {
              "type": "keyword",
              "ignore_above": 64
            },
            "alert": {
              "type": "object",
              "dynamic": "strict",
              "properties": {
                "rule_id": {
                  "type": "keyword",
                  "ignore_above": 128
                },
                "rule_name": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "risk_score": {
                  "type": "float"
                },
                "source_event_ids": {
                  "type": "keyword",
                  "ignore_above": 512
                }
              }
            }
          }
        }
      }
    }
  }
}
