{
  "_doc": "Composable index template for the deception-events data stream (normalized honeypot interaction events). Created via API by deploy/elastic/scripts/bootstrap-security.sh --install-templates. Compatible with ECS 8.x. NOTE: top-level dynamic=false so that any field NOT declared here (e.g. payloads, passwords) is stored in _source but NOT indexed/aggregated: by default there are no aggregable sensitive fields. The dystopia object is dynamic=strict: adding a non-declared field REJECTS the document (fail fast against schema drift).",
  "index_patterns": [
    "deception-events",
    "deception-events-*"
  ],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "lifecycle": {
          "name": "deception-events-policy",
          "rollover_alias": "deception-events"
        },
        "refresh_interval": "5s",
        "codec": "best_compression"
      }
    },
    "mappings": {
      "dynamic": "false",
      "_meta": {
        "dystopia": "1.0.0",
        "ecs_version": "8.x",
        "hp_oce": "agent4-elastic"
      },
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "event": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 512
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 256
            },
            "category": {
              "type": "keyword",
              "ignore_above": 256
            },
            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "action": {
              "type": "keyword",
              "ignore_above": 256
            },
            "severity": {
              "type": "long"
            },
            "outcome": {
              "type": "keyword",
              "ignore_above": 256
            },
            "dataset": {
              "type": "keyword",
              "ignore_above": 256
            },
            "ingested": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            }
          }
        },
        "source": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "as": {
              "type": "object",
              "dynamic": "false",
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "type": "keyword",
                  "ignore_above": 512
                }
              }
            },
            "geo": {
              "type": "object",
              "dynamic": "false",
              "properties": {
                "country_name": {
                  "type": "keyword",
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  },
                  "ignore_above": 256
                },
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 8
                },
                "continent_name": {
                  "type": "keyword",
                  "ignore_above": 64
                },
                "city_name": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "timezone": {
                  "type": "keyword",
                  "ignore_above": 64
                },
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        },
        "destination": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            }
          }
        },
        "network": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "transport": {
              "type": "keyword",
              "ignore_above": 64
            },
            "protocol": {
              "type": "keyword",
              "ignore_above": 128
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            }
          }
        },
        "observer": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 128
            },
            "name": {
              "type": "keyword",
              "ignore_above": 128
            },
            "product": {
              "type": "keyword",
              "ignore_above": 128
            },
            "vendor": {
              "type": "keyword",
              "ignore_above": 128
            },
            "version": {
              "type": "keyword",
              "ignore_above": 32
            }
          }
        },
        "session": {
          "type": "object",
          "dynamic": "false",
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "dystopia": {
          "type": "object",
          "dynamic": "strict",
          "properties": {
            "schema_version": {
              "type": "keyword",
              "ignore_above": 16
            },
            "device_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "segment_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "instance_id": {
              "type": "keyword",
              "ignore_above": 128
            },
            "persona": {
              "type": "keyword",
              "ignore_above": 128
            },
            "decoy_credentials": {
              "type": "keyword",
              "ignore_above": 256,
              "_comment": "Identifiers (UUID/nombre) of the decoy credentials involved, NEVER the credential value. If the ingest adds passwords/users, it must do so under a field with index:false or as raw_reference."
            },
            "decoy_credential_matches": {
              "type": "integer"
            },
            "decoy_credential_realm": {
              "type": "keyword",
              "ignore_above": 128
            },
            "raw_reference": {
              "type": "keyword",
              "ignore_above": 512
            },
            "ingest_source": {
              "type": "keyword",
              "ignore_above": 64
            },
            "control_version": {
              "type": "keyword",
              "ignore_above": 64
            }
          }
        }
      }
    }
  }
}
