# Compose LOCAL (macOS Docker Desktop). No usar en producción.
# Genera un secreto único la primera vez:
#   umask 077; printf 'NETPULSE_JWT_SECRET=%s\n' "$(openssl rand -hex 32)" > .env
NETPULSE_JWT_SECRET=
# Network Fabric (§9.1): doble gate. Deploy/consola quedan cerrados por defecto.
# DYSTOPIA_FABRIC_ENABLED=true
# DYSTOPIA_FABRIC_ENGINE=stub|ovs|remote
# Consola interactiva (Fase 11): requiere true también en el servicio del host
# (/etc/dystopia/fabric.env) cuando el engine es "remote".
# DYSTOPIA_FABRIC_CONSOLE_ENABLED=false
# Solo para docker-compose.remote.yml: IPv4 de este host en Tailscale.
# No incluyas la dirección real en Git.
DYSTOPIA_TAILSCALE_IP=

# ── Trampa HTTP (OpenCanary, módulo http) ────────────────────────────────
# Único puerto HTTP publicado por la pila: el módulo http del contenedor
# opencanary (80 en el contenedor) se publica en <DYSTOPIA_HTTP_TRAP_BIND>:
# <DYSTOPIA_HTTP_TRAP_PORT>. Nunca se publican 80/443 ni otros puertos de
# honeypots.
#
#   DYSTOPIA_HTTP_TRAP_PORT  puerto del host que recibe los ataques (8080).
#   DYSTOPIA_HTTP_TRAP_BIND  IP de escucha en el host. Sin override remoto el
#                            compose publicará solo en loopback; en el
#                            servidor (con docker-compose.remote.yml) el
#                            valor esperado es la IP WireGuard 10.66.0.3.
#
# Para recibir ataques reales desde fuera del laboratorio, el operador debe
# además permitir el puerto en el firewall del host (no lo aplica el repo):
#
#   ufw allow from any to 10.66.0.3 port 8080 proto tcp
#
# (sustituye 8080/10.66.0.3 por los valores reales de las dos variables).
# Ver docs/MIGRACION-PUERTOS.md y docs/NETWORK-MATRIX.md.
DYSTOPIA_HTTP_TRAP_PORT=8080
DYSTOPIA_HTTP_TRAP_BIND=10.66.0.3
