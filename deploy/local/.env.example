# Compose LOCAL (macOS Docker Desktop). No usar en producción.
# Genera un secreto único la primera vez:
#   umask 077; printf 'NETPULSE_JWT_SECRET=%s\n' "$(openssl rand -hex 32)" > .env
NETPULSE_JWT_SECRET=
# Network Fabric (§9.1): doble gate. Deploy/consola quedan cerrados por defecto.
# DYSTOPIA_FABRIC_ENABLED=true
# DYSTOPIA_FABRIC_ENGINE=stub|ovs|remote
# Consola interactiva (Fase 11): requiere true también en el servicio del host
# (/etc/dystopia/fabric.env) cuando el engine es "remote".
# DYSTOPIA_FABRIC_CONSOLE_ENABLED=false
# Solo para docker-compose.remote.yml: IPv4 de este host en Tailscale.
# No incluyas la dirección real en Git.
DYSTOPIA_TAILSCALE_IP=
