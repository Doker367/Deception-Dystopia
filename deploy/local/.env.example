# Compose LOCAL (macOS Docker Desktop). No usar en producción.
# Genera un secreto único la primera vez:
#   umask 077; printf 'NETPULSE_JWT_SECRET=%s\n' "$(openssl rand -hex 32)" > .env
NETPULSE_JWT_SECRET=
# Solo para docker-compose.remote.yml: IPv4 de este host en Tailscale.
# No incluyas la dirección real en Git.
DYSTOPIA_TAILSCALE_IP=
