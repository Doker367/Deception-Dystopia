# Control plane local — imagen de laboratorio.
#
# Copia el repositorio completo (app/, runtime/, web/dist ya construido) y
# sirve la web estática desde el propio árbol. La configuración mutable
# (users.yaml) y el estado (SQLite) viven en volúmenes, no en la imagen.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/srv/app \
    HOME=/tmp

WORKDIR /srv/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /srv/app/requirements.txt
RUN pip install --no-cache-dir --no-compile -r /srv/app/requirements.txt

COPY app/ /srv/app/app/
COPY runtime/ /srv/app/runtime/
COPY config/ /srv/app/config/
COPY web/dist/ /srv/app/web/dist/
COPY deploy/honeypots/inventory.yaml /srv/app/deploy/honeypots/inventory.yaml
COPY deploy/honeypots/fixtures/ /srv/app/deploy/honeypots/fixtures/

USER 2000:2000

EXPOSE 8082

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8082"]
