# ============================================================================
# Dystopia - Elastic stack, variables OBLIGATORIAS (SOLO ejemplo, NO versionar
# el secreto real). Copiar a deploy/elastic/.env (excluido del repo) y rellenar
# con valores ÚNICOS Generados per-instance:
#     cp .env.example .env
# Requiere fichero .env real para que el Compose arranque (`:?` lo obliga).
# ============================================================================

# ---- Versiones FIJADAS (sincronizadas con tpotce 24.04.1 stack ES/KB 9.3.5).
# NO usar `latest`.
ELASTIC_VERSION=9.3.5

# ---- Superusuario 'elastic' bootstrap (ÚNICO por instancia, >=24 chars,
# alfanuméricos + símbolos, sin espacios). Opcional: si se deja vacío,
# el nodo genera una clave de arranque y la imprime en el log; se registra en
# el gestor de secretos operativo, no en este fichero.
ELASTIC_PASSWORD=CHANGEME_UNIQUE_ADMIN_PASSWORD_PER_INSTANCE

# ---- Usuario de servicio kibana_system (creado por bootstrap-security.sh
# con password aleatoria conocida solo en .env en producción).
KIBANA_SYSTEM_PASSWORD=CHANGEME_KIBANA_SERVICE_TOKEN

# ---- Claves de cifrado de Kibana (OBLIGATORIAS con xpack.security en 9.x).
# Generar ÚNICAS:  32 bytes como hex (64 chars):
#    openssl rand -hex 32
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=CHANGEME_openssl_rand_hex_32
KIBANA_SECURE_SAVED_OBJECTS_ENCRYPTION_KEY=CHANGEME_openssl_rand_hex_32

# ---- Recursos. ES heap (Xms/Xmx). mem_limit container debe ser ~heap*1.5.
ELASTIC_JAVA_OPTS=-Xms2048m -Xmx2048m
ELASTIC_MEMORY_LIMIT=3g
KIBANA_MEMORY_LIMIT=1536m

# ---- Rutas en el HOST. Para un laboratorio real usa rutas absolutas fuera del
# repo (ej. /Users/tu-usuario/dystopia-lab/data/elastic). Los valores relativos
# de abajo están ignorados por git y sirven solo para una demo local.
ELASTIC_DATA_DIR=./data/elastic
KIBANA_DATA_DIR=./data/kibana
ELASTIC_CERTS_DIR=./deploy/elastic/certs

# ---- Retención configurable (días). El bootstrap aplica ILM con estos valores.
ILM_DECEPTION_EVENTS_DAYS=30
ILM_DECEPTION_ALERTS_DAYS=90

# ---- Binding de gestión. NUNCA 0.0.0.0. Solo 127.0.0.1, o la interface
# de gestión dedicada (p.ej. 198.51.100.10) del despliegue real.
ELASTIC_BIND_IP=127.0.0.1
ELASTIC_HTTP_PORT=9200
KIBANA_BIND_IP=127.0.0.1
KIBANA_HTTP_PORT=5601

# ---- Identificación del clúster/panel (no secreto).
TZ=Europe/Madrid
KIBANA_PUBLIC_BASE_URL=http://127.0.0.1:5601
KIBANA_REPORTING_ENABLED=false

# ---- Usuarios funcionales (created by bootstrap-security.sh; mínimo 12 chars
# alfanum + símbolo). Cada usuario una password distinta. No compartadas.
DECEPTION_WRITER_PASSWORD=CHANGEME_ingest_writer_password
DECEPTION_ANALYST_PASSWORD=CHANGEME_analyst_password
DECEPTION_ADMIN_PASSWORD=CHANGEME_daily_admin_password

# ---- Frase de la CA TLS. Obligatoria para generate-certs.sh. No versionar.
#      Mínimo 20 caracteres; única por instancia.
ELASTIC_CA_PASSPHRASE=CHANGEME_CA_PASSPHRASE_20_PLUS_CHARS

# ---- Directorio privado para API keys emitidas por bootstrap-security.sh.
#      Debe estar fuera del control de versiones, con permisos 0700.
#      El publicador recibe la ruta del fichero de la key, nunca su valor.
ELASTIC_API_KEY_DIR=./deploy/elastic/api-keys
DYSTOPIA_ELASTIC_API_KEY_FILE=./deploy/elastic/api-keys/deception-ingest-writer.api-key

# ---- Dystopia Web analytics BFF (read-only) --------------------------------
# La web nunca habla con Elasticsearch. FastAPI usa esta identidad de solo
# lectura para /api/analytics/*. Mantener el fichero de API key en 0600 y
# fuera del repositorio.
DYSTOPIA_ANALYTICS_ENABLED=false
DYSTOPIA_ANALYTICS_URL=https://127.0.0.1:9200
DYSTOPIA_ANALYTICS_INDEX=deception-events*
DYSTOPIA_ANALYTICS_ALERTS_INDEX=deception-alerts*
DYSTOPIA_ANALYTICS_API_KEY_FILE=./deploy/elastic/api-keys/dystopia-analytics-reader.api-key
DYSTOPIA_ANALYTICS_CA_FILE=./deploy/elastic/certs/ca.crt
DYSTOPIA_ANALYTICS_TIMEOUT=5
