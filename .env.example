# Reference only: .env is no longer loaded automatically.
# Use runtime.install and explicit per-service EnvironmentFile provisioning.
# No sensor may receive this administrative environment.
NETPULSE_ENV=production
# JWT secret deliberately absent. Installer generates it privately; missing = fail closed.
DYSTOPIA_CONTROL_STATE=/var/lib/dystopia/control
DYSTOPIA_CONTROL_CONFIG=/var/lib/dystopia/control/config
NETPULSE_DECEPTION_ENABLED=false
# Ruta al fichero privado (0600) con la clave HMAC de dystopia.raw_reference.
# Nunca el valor de la clave. Sin fichero, el normalizador ECS falla cerrado.
# DYSTOPIA_EVENT_REFERENCE_KEY_FILE=/etc/dystopia/event-reference.key
NETPULSE_VMS_ENABLED=false
NETPULSE_FIREWALL_ENABLED=false
NETPULSE_SYSLOG_ENABLED=false
NETPULSE_METRICS_ENABLED=false
NETPULSE_AI_ENABLED=false
NETPULSE_DECEPTION_AI_FP_ENABLED=false
# Legacy shared ingestion tokens and simulation/private allowlist flags are retired.
# Initial administrator is created only through local getpass bootstrap.
