# Dystopia — variables de entorno de ejemplo
# Copiar a .env (NO versionado) y completar con valores propios.
# Generar valores aleatorios: openssl rand -hex 32
# Use secretos exclusivos de Dystopia; nunca reutilice los del NOC.
# Los nombres NETPULSE_* se conservan temporalmente por compatibilidad con el
# código heredado; una migración a DYSTOPIA_* está prevista en BACKLOG.md.

# ── Usuarios iniciales (scripts/seed_users.py) ─────────────
# Sin valores por defecto: el script exige estas variables.
DYSTOPIA_ADMIN_PASSWORD=
DYSTOPIA_OPERATOR_PASSWORD=

# ── API de control ─────────────────────────────────────────
# Loopback por defecto. La API de control nunca debe compartir interfaz con
# la red señuelo: use una interfaz/VLAN dedicada para los listeners.
NETPULSE_HOST=127.0.0.1
NETPULSE_PORT=8082
NETPULSE_SSL_CERTFILE=
NETPULSE_SSL_KEYFILE=

# ── Red señuelo / Honeypot (Deception) ─────────────────────
# Deshabilitada por defecto: no se abre ningún puerto señuelo.
NETPULSE_DECEPTION_ENABLED=false
# Token de ingesta exclusivo de Dystopia (nunca el del NOC).
NETPULSE_DECEPTION_INGEST_TOKEN=
# Interfaz del bridge de deception (modo paquete del engine Go).
NETPULSE_DECEPTION_IFACE=deception0
# Forzar host de bind del motor nativo (vacío = IP de cada dispositivo señuelo).
# En desarrollo use 127.0.0.1; nunca una interfaz de gestión.
NETPULSE_DECEPTION_BIND_HOST=
# Alertas de deception
NETPULSE_DECEPTION_ALERTS_ENABLED=false
NETPULSE_DECEPTION_ALERT_COOLDOWN=60
NETPULSE_DECEPTION_BRUTE_FORCE_THRESHOLD=5
NETPULSE_DECEPTION_BRUTE_FORCE_WINDOW=60
# Bloqueo automático de IPs ante alertas critical (deshabilitado).
NETPULSE_DECEPTION_AUTOBLOCK_CRITICAL=false
# Reducción de falsos positivos (alertas)
NETPULSE_DECEPTION_ALERT_IGNORE_SIMULATED=true
NETPULSE_DECEPTION_ALERT_IGNORE_LOOPBACK=true
NETPULSE_DECEPTION_ALERT_IGNORE_PRIVATE=false
# GeoIP offline (vacío = autodetecta la de maxminddb-geolite2)
NETPULSE_GEOIP_DB=
# Ubicación del centro de datos (punto verde del mapa global)
NETPULSE_DATACENTER_LAT=0
NETPULSE_DATACENTER_LON=0
NETPULSE_DATACENTER_NAME=Data Center
# Firewall: false = dry-run (solo muestra los comandos).
NETPULSE_FIREWALL_ENABLED=false

# ── Máquinas señuelo (VMs con QEMU) ────────────────────────
# Deshabilitadas por defecto. Nunca exponga VNC más allá del loopback.
NETPULSE_VMS_ENABLED=false
NETPULSE_VMS_VNC_BASE_PORT=5900
NETPULSE_VMS_SERIAL_BASE_PORT=45000

# ── Colectores (deshabilitados por defecto) ────────────────
NETPULSE_SYSLOG_ENABLED=false
NETPULSE_SYSLOG_HOST=127.0.0.1
NETPULSE_SYSLOG_PORT=5514
NETPULSE_SYSLOG_BATCH_INTERVAL=0.5
NETPULSE_SYSLOG_BATCH_MAX=1000
NETPULSE_SYSLOG_QUEUE_MAX=20000
NETPULSE_METRICS_ENABLED=false
NETPULSE_METRICS_INTERVAL=60
NETPULSE_LOKI_URL=http://localhost:3100

# ── Capa de decisiones IA (Laya) ───────────────────────────
# Motor "System One" servido por HTTP (docker-compose.ai.yml, loopback 8090).
# Deshabilitado por defecto: todo cae de vuelta a la lógica por reglas.
NETPULSE_AI_ENABLED=false
NETPULSE_AI_BACKEND=laya
NETPULSE_AI_BASE_URL=http://127.0.0.1:8090
NETPULSE_AI_MODEL=multilingual
NETPULSE_AI_CONFIDENCE_FLOOR=0.90
NETPULSE_AI_TIMEOUT=8
NETPULSE_AI_CACHE_TTL=300
NETPULSE_AI_JEV_STRICT=true

# ── Falsos positivos de deception con IA ───────────────────
NETPULSE_DECEPTION_AI_FP_ENABLED=false
NETPULSE_DECEPTION_AI_FP_SUPPRESS=false
NETPULSE_DECEPTION_AI_FP_MIN_CONFIDENCE=0.90

# ── Alertmanager webhook (auth de servicio) ────────────────
NETPULSE_ALERTMANAGER_TOKEN=

# ── Grafana (docker-compose.monitoring.yml) ────────────────
# Obligatorio cuando se usa ese compose; no se publica en 0.0.0.0.
GRAFANA_ADMIN_PASSWORD=
