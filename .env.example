# Reference only: .env is no longer loaded automatically.
# Use runtime.install and explicit per-service EnvironmentFile provisioning.
# No sensor may receive this administrative environment.
NETPULSE_ENV=production
# JWT secret deliberately absent. Installer generates it privately; missing = fail closed.
DYSTOPIA_CONTROL_STATE=/var/lib/dystopia/control
DYSTOPIA_CONTROL_CONFIG=/var/lib/dystopia/control/config
NETPULSE_DECEPTION_ENABLED=false
# GeoIP offline. Opcional: ruta exacta a GeoLite2-City.mmdb o directorio que
# la contenga. Sin esto se autodetecta config/geoip, deploy/local/geoip y la
# base incluida en el paquete maxminddb-geolite2.
# NETPULSE_GEOIP_DB=/var/lib/dystopia/geoip/GeoLite2-City.mmdb
# NETPULSE_GEOIP_DIR=/var/lib/dystopia/geoip
# Ruta al fichero privado (0600) con la clave HMAC de dystopia.raw_reference.
# Nunca el valor de la clave. Sin fichero, el normalizador ECS falla cerrado.
# DYSTOPIA_EVENT_REFERENCE_KEY_FILE=/etc/dystopia/event-reference.key
NETPULSE_VMS_ENABLED=false
NETPULSE_FIREWALL_ENABLED=false
NETPULSE_SYSLOG_ENABLED=false
NETPULSE_METRICS_ENABLED=false
NETPULSE_AI_ENABLED=false
NETPULSE_DECEPTION_AI_FP_ENABLED=false
# RAG local de ataques (memoria). Requiere llama.cpp con embeddings + LLM.
NETPULSE_RAG_ENABLED=false
# NETPULSE_RAG_DB=/var/lib/dystopia/deception/rag.db
# NETPULSE_RAG_EMBED_URL=http://127.0.0.1:8081/v1/embeddings
# NETPULSE_RAG_EMBED_MODEL=qwen3-embedding-0.6b
# NETPULSE_RAG_EMBED_DIM=1024
# NETPULSE_RAG_LLM_URL=http://127.0.0.1:8091/v1/chat/completions
# NETPULSE_RAG_LLM_MODEL=her-9b
# NETPULSE_RAG_LLM_DISABLE_THINKING=true
# Privacidad: por defecto no se indexan comandos, URLs ni usuarios capturados.
# NETPULSE_RAG_INCLUDE_PAYLOAD=false
# Monitor proactivo: evalúa eventos y notifica hallazgos.
# NETPULSE_AI_MONITOR_ENABLED=true
# NETPULSE_AI_MONITOR_WINDOW_MIN=15
# NETPULSE_AI_MONITOR_MIN_EVENTS=8
# NETPULSE_AI_MONITOR_MIN_CONFIDENCE=0.55
# NETPULSE_AI_MONITOR_COOLDOWN_MIN=180
# NETPULSE_AI_MONITOR_NOTIFY_MIN_SEVERITY=medium
# Push autoalojado opcional (ntfy).
# NETPULSE_NTFY_URL=http://127.0.0.1:8085
# NETPULSE_NTFY_TOPIC=dystopia-ia
# Legacy shared ingestion tokens and simulation/private allowlist flags are retired.
# Initial administrator is created only through local getpass bootstrap.
