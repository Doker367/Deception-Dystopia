{
  "description": "TEMPLATE ONLY. Never store credentials here: token_file points to operator-provisioned, owner-only files outside the repository. The opt-in lab test is skipped unless the lab markers and target allowlist are present.",
  "lab": {
    "purpose": "dystopia-disposable-lab",
    "authorization_id": "lab-2026-10-29-01"
  },
  "targets": [
    "127.0.0.1",
    "192.168.56.10",
    "192.168.56.20"
  ],
  "dystopia": {
    "base_url": "https://192.168.56.10:8099",
    "token_file": "/run/dystopia-lab/dystopia.token",
    "ca_file": "/run/dystopia-lab/lab-ca.pem",
    "health_path": "/api/health",
    "checks": [
      {
        "name": "device present in topology",
        "method": "GET",
        "path": "/api/deception/network",
        "pointer": "devices",
        "op": "contains_value",
        "value": "srv-files-01"
      },
      {
        "name": "cowrie associated with device",
        "method": "GET",
        "path": "/api/deception/integrations/status",
        "pointer": "cowrie.device_id",
        "op": "equals",
        "value": "srv-files-01"
      },
      {
        "name": "activation authorized",
        "method": "GET",
        "path": "/api/console/devices/srv-files-01",
        "pointer": "activation.state",
        "op": "in",
        "value": [
          "authorized",
          "active"
        ]
      }
    ],
    "persistence_check": {
      "name": "event persisted in Dystopia telemetry",
      "method": "GET",
      "path": "/api/deception/events",
      "pointer": "events[0].event_id",
      "op": "exists"
    }
  },
  "elasticsearch": {
    "base_url": "https://192.168.56.10:9200",
    "token_file": "/run/dystopia-lab/elastic.token",
    "ca_file": "/run/dystopia-lab/lab-ca.pem",
    "index_pattern": "logstash-*"
  },
  "kibana": {
    "base_url": "https://192.168.56.10:5601",
    "token_file": "/run/dystopia-lab/kibana.token",
    "ca_file": "/run/dystopia-lab/lab-ca.pem",
    "data_view_id": "dystopia-events-lab",
    "time_field": "@timestamp"
  },
  "event": {
    "device_id": "srv-files-01",
    "segment_id": "seg-lab-edge",
    "instance_id": "cell-lab-01",
    "persona": "linux-file-server",
    "observer_name": "cowrie-lab-01",
    "source_ip": "203.0.113.9"
  },
  "ssh": {
    "description": "Operator-performed benign SSH login to the lab honeypot. The automated test never opens SSH and never sends credentials or exploits.",
    "performed_env": "DYSTOPIA_LAB_SSH_PERFORMED",
    "performed_token": "LAB-SYNTHETIC-SSH-V1",
    "host": "192.168.56.20",
    "port": 22,
    "username": "lab-synthetic"
  },
  "publisher": {
    "restart_path": "/api/console/publisher/restart",
    "restart_method": "POST",
    "restart_settle_seconds": 20,
    "expected_duplicates_after_restart": 0
  },
  "poll": {
    "timeout_seconds": 90,
    "interval_seconds": 3
  },
  "filters": [
    {
      "label": "device",
      "field": "dystopia.device_id",
      "op": "eq",
      "value": "srv-files-01",
      "min_count": 1
    },
    {
      "label": "segment",
      "field": "dystopia.segment_id",
      "op": "eq",
      "value": "seg-lab-edge",
      "min_count": 1
    }
  ]
}
