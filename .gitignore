# Fernet encryption key — NEVER COMMIT
config/.fernet_key

# Herramientas locales de diseño (no forman parte del producto)
.taste-skill/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Backups (generated) — nunca commitear snapshots de dispositivos
backups/*

# Audit logs (pueden contener IPs/usernames)
audit/

# Deception telemetry (eventos de atacantes)
/deception/

# Binarios del data plane en Go
deception-engine/bin/

# Environment
.env
.env.*
!.env.example

# Docker volumes (persistent data)
docker/volumes/

# NetBox data (persistent)
netbox-media/
netbox-reports/
netbox-scripts/
netbox-db-data/
netbox-redis-data/

# Loki/Prometheus data (persistent)
loki_data/
prometheus_data/
grafana_data/

# Scheduler jobs (generated)
config/scheduler_jobs.json

# Generated state files
config/maintenance_windows.json
config/api_keys.json
config/drift_history/
config/baselines/
# Solo la carpeta de reportes en la raíz (evita ignorar app/services/reports/)
/reports/

# Secretos locales (no commitear)
config/alertmanager.yml

# Logs
*.log
logs/
# Fixtures sintéticos usados por los tests de higiene (sin secretos reales)
!tests/integration_unified/fixtures/logs/
!tests/integration_unified/fixtures/logs/**

# Temp files
/tmp/
*.tmp
*.bak

# API tokens (NEVER COMMIT)
config/.netbox_token
config/.netbox_token.*

# Credenciales iniciales rotadas (NEVER COMMIT)
config/.initial_credentials

# Deception: host keys persistentes (secretos locales)
config/deception/keys/
# Deception: VMs e ISOs (grandes, datos locales)
config/deception/isos/
config/deception/vms.json

# Dystopia private material and generated state.
# IMPORTANTE: runtime/ es CÓDIGO FUENTE (planos control/sensor/ingestión/aislamiento)
# y debe versionarse. El estado generado vive en /var/lib/dystopia.
data/
deploy/elastic/api-keys/
*.db
*.db-wal
*.db-shm
*.iso
*.img
*.qcow2
*.vdi
*.vmdk
*.pem
*.key
config/deception/keys/
config/deception/isos/
config/deception/images/
config/deception/vms.json
secrets/

# Runtime metrics history (host/device state, not source)
config/metrics_history.json

# Variantes experimentales de dashboards no certificadas
deploy/kibana-dashboards/artifacts/*EXPERIMENTAL*
